# TouchWB 方案仓库忽略规则
# 注意：gitignore 不支持行尾注释，注释必须独立成行

# 编译产物
build/
*.bin

# 运行日志
log/
*.log

# 用户动态数据库（随使用增长，不入库）
*.userdb
*.userdb.log
*.db-shm
*.db-wal
custom_phrase.db

# 备份与临时文件
*.bak
*.tmp
tmp/

# 本机运行时状态（各设备不同，不入库）
user.yaml

# 运行时被数据覆写的统计脚本副本（死代码，统计实际走 input_statistics.lua）
lua/input_stats_ly_*.lua

# super_sequence 打字序列数据（运行时写 user_data_dir/lua/sequence_<schema>.txt，带时间戳）
sequence_*.txt

# 系统杂项
.DS_Store
Thumbs.db
desktop.ini
