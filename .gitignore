# TouchWB 仓库（git 根 = dev/）忽略规则
# 追踪：dev/docs、space/schemas/TouchWB、space/patches、dev/tools 脚本、space.yaml / space.custom.yaml、dev 顶层计划文档
# 注意：gitignore 不支持行尾注释，注释必须独立成行

# ── 编译产物（任何层级）──
build/
*.bin

# ── 日志（任何层级）──
log/
*.log

# ── 用户动态数据库（随使用增长，不入库）──
*.userdb
*.userdb.log
*.db-shm
*.db-wal
custom_phrase.db

# ── 运行时自生成文件（非方案源码，不入库；注意用精确路径，勿误伤 patches 里的同名补丁资源）──
/space/schemas/TouchWB/custom_phrase.txt
/space/schemas/TouchWB/user_coined_ext.txt
/space/schemas/TouchWB/user_coined_auto.txt

# ── 备份与临时文件 ──
*.bak
*.tmp
tmp/
*.zip

# ── 本机运行时状态（各设备不同，不入库）──
user.yaml
installation.yaml
.space_update_stamp

# ── 死代码（统计实际走 input_statistics.lua）──
**/lua/input_stats_ly_*.lua
sequence_*.txt

# ── space 根目录手机自带文件（非方案本体）──
/space/README.md
/space/LICENSE

# ── space 根目录手机运行时资源（非方案本体）──
/space/emoticons/
/space/fonts/
/space/haptics/
/space/pasteboard/
/space/plugins/
/space/resources/
/space/sounds/
/space/speeches/
/space/symbols/
/space/textflow/
/space/themes/
/space/tools/
/space/tutorials/

# ── 其它方案（非优化对象）──
/space/schemas/bim-pinyin/
/space/schemas/bim-wubi/
/space/schemas/sbsrf/
/space/schemas/方案1/

# ── tools 下的生成产物（脚本保留，产物不入库）──
/tools/assoc_fixed_supplement.txt

# ── 系统杂项 ──
.DS_Store
Thumbs.db
desktop.ini
